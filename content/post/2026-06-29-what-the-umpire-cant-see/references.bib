@misc{spencer2023,
  type = {Blog},
  title = {Pitch Selection to Maximize Motion-in-Depth Variation},
  shorttitle = {Pitch Selection to Maximize Motion-in-Depth Variation},
  author = {Spencer, Scott},
  year = 2023,
  month = mar,
  urldate = {2026-06-11},
  abstract = {Those in baseball are well aware of the concept of platoon advantage: batters tend to have an advantage when facing pitchers of the opposite handedness. But knowledge of a platoon advantage may go beyond choice of relief pitchers on the mound to matchup with the upcoming lineup of power batters. It may inform, among other things, pitching strategy. Considering reasons behind the phenomenon, it may be explained by the greater relative variation in movement of the ball inside a batter's plane of sight, which I'll define in a moment, while same-handed pitchers tend to keep the ball's trajectory more aligned with that plane, making it harder to perceive lateral movement.},
  chapter = {Baseball},
  howpublished = {https://ssp3nc3r.github.io/post/pitch-selection-to-maximize-motion-in-depth/},
  langid = {english},
  file = {/Volumes/WORK_A/Papers/Zotero/storage/B67MXYKA/pitch-selection-to-maximize-motion-in-depth.html}
}

